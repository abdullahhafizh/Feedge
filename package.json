{
  "name": "feedge",
  "version": "1.0.0",
  "description": "Dynamic SVG badge that displays your latest blog posts from an RSS feed for GitHub README profiles",
  "type": "module",
  "scripts": {
    "dev": "bun run src/dev-server.ts",
    "build": "bun build src/index.ts --outdir dist --target node",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "generate": "bun run src/cli/generate-badge.ts",
    "ci": "bun run typecheck && bun test"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@vercel/node": "^5.5.15",
    "typescript": "^5.9.3"
  }
}