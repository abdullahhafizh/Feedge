# Feedge - Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# REQUIRED
# ===========================================

# Secret key for HMAC signature validation
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNING_SECRET=your-secret-key-here

# ===========================================
# OPTIONAL
# ===========================================

# Server port (dev server only)
# PORT=3000

# Enable/disable URL generator page
# Set to 0, false, no, or off to disable
# URL_GENERATOR_ENABLED=true

# Default theme (light or dark)
# DEFAULT_THEME=light

# Default max items to display
# MAX_ITEMS=5

# Request timeout in milliseconds
# TIMEOUT_MS=8000

# ===========================================
# MONITORING (Optional)
# ===========================================

# Webhook URL for external monitoring (Slack, Discord, etc.)
# Events like errors and security violations will be POST-ed here
# MONITORING_WEBHOOK_URL=https://hooks.slack.com/services/xxx